# ============================================================
# prihora — variaveis de ambiente
# Copie para .env (make setup faz isso) e ajuste o que precisar.
# ============================================================

# --- Ambiente ---
ENV=development
PROJECT_NAME=prihora

# --- Banco de dados ---
POSTGRES_USER=prihora
POSTGRES_PASSWORD=prihora_dev_password
POSTGRES_DB=prihora
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Backend ---
# TROQUE EM PRODUCAO: openssl rand -hex 32
SECRET_KEY=dev-secret-change-me-in-production-0123456789abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=10080
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Admin bootstrap (criado no seed) ---
ADMIN_EMAIL=admin@prihora.pt
ADMIN_PASSWORD=admin123
ADMIN_NAME=Administrador

# --- Frontend ---
# Origem da API vista pelo NAVEGADOR, SEM o caminho /api/v1 (o cliente ja o anexa).
#   dev  -> http://localhost:8000   (o navegador fala direto com a API)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Em PRODUCAO o frontend usa esta variavel (e nao a de cima).
# "/" = mesma origem: o nginx roteia /api/* para a API.
# Troque apenas se a API ficar em outro dominio, ex.: https://api.seudominio.com
PUBLIC_API_ORIGIN=/
# URL do backend acessivel pelo SERVIDOR Next (SSR, dentro da rede docker)
API_INTERNAL_URL=http://backend:8000
NEXT_PUBLIC_SITE_NAME=prihora

# --- Portas expostas no host ---
FRONTEND_PORT=3000
BACKEND_PORT=8000
DB_PORT=5432
PROD_HTTP_PORT=80

# --- Mensageria: WhatsApp ---
# O e-mail foi retirado: todas as mensagens saem por WhatsApp.
# Segredo partilhado entre o backend e o servico de WhatsApp. Os dois estao na
# rede interna, mas TROQUE em producao: openssl rand -hex 24
WHATSAPP_TOKEN=troque-este-segredo-interno
WHATSAPP_ENABLED=true
WHATSAPP_LOG_LEVEL=info

# --- Geocodificacao inversa ---
# Alimenta o botao "usar a minha localizacao": traduz coordenadas em morada,
# localidade e distrito. O Nominatim e gratuito e pede so um User-Agent
# identificavel. Desligue se nao quiser chamadas para fora; a localidade e o
# distrito continuam a sair da cidade conhecida mais proxima.
GEOCODING_ENABLED=true
GEOCODING_URL=https://nominatim.openstreetmap.org/reverse
GEOCODING_USER_AGENT=prihora/1.0 (marketplace de estetica)

# --- Seed ---
SEED_DEMO_DATA=true
